# Copy to .env and adjust.

PORT=3000

# Public origin of this tracker. Tracking links are built from it, so set it to
# your real domain in production (e.g. https://track.example.com).
BASE_URL=http://localhost:3000

# Salt for hashing visitor IPs. Generate once and keep it stable, otherwise
# unique-visitor counts restart from zero every deploy:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_SALT=

# Where the SQLite file lives (local development / any host with real disk).
DB_PATH=./data/tracking.db

# Set BOTH to use a hosted Turso (libSQL) database instead of the local file
# above — required on Vercel, whose functions have no writable disk. Get these
# from `turso db show <name> --url` and `turso db tokens create <name>` after
# `turso db create`. Leave both blank for local development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Password gate on the dashboard and link-management API (any username works
# with HTTP Basic Auth). Leave unset for local development; REQUIRED before
# putting this on a public host, or anyone can create links and read your
# click data. The redirect itself (/<code>) is never gated — visitors don't
# need a password to be tracked and sent to the destination.
ADMIN_PASSWORD=
