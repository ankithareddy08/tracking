<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow">
<title>Redirecting…</title>
<!-- No-JS and beacon-blocked fallback. The click is already recorded server
     side, so this path only loses the refined source, never the visit. -->
<meta http-equiv="refresh" content="1;url=<%= destination %>">
<style>
  body { margin:0; height:100vh; display:grid; place-items:center;
         font:14px/1.5 ui-sans-serif,-apple-system,"Segoe UI",Roboto,sans-serif;
         color:#5a6675; background:#fff; }
  /* Stays invisible for the first 400ms so a normal fast redirect shows
     nothing at all — only a genuinely slow hop ever reveals this. */
  p { opacity:0; animation:show 0s linear .4s forwards; }
  @keyframes show { to { opacity:1 } }
  @media (prefers-color-scheme:dark) { body { background:#0d1117; color:#8b98a5 } }
</style>
</head>
<body>
<p>Redirecting…</p>
<script>
(function () {
  var destination = <%- JSON.stringify(destination) %>;

  function webviewKind() {
    try {
      if (window.ReactNativeWebView) return 'reactNative';
      if (window.webkit && window.webkit.messageHandlers) return 'iosWebView';
      // "; wv)" is the marker Android stamps into an embedded WebView's UA.
      if (/; wv\)/.test(navigator.userAgent)) return 'androidWebView';
    } catch (e) { /* ignore */ }
    return null;
  }

  var payload = JSON.stringify({
    id: <%- JSON.stringify(clickId) %>,
    token: <%- JSON.stringify(token) %>,
    referrer: document.referrer || null,
    userAgent: navigator.userAgent || null,
    webview: webviewKind(),
    viewport: [
      window.innerWidth, window.innerHeight,
      screen.width, screen.height,
      window.devicePixelRatio || 1
    ].join('x')
  });

  // sendBeacon is built to survive the page being torn down by the redirect,
  // which is why the navigation does not need to wait for it.
  try {
    var sent = false;
    if (navigator.sendBeacon) {
      sent = navigator.sendBeacon('/api/probe', new Blob([payload], { type: 'application/json' }));
    }
    if (!sent) {
      fetch('/api/probe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: payload,
        keepalive: true
      }).catch(function () {});
    }
  } catch (e) { /* attribution is best-effort; never block the redirect */ }

  // replace() so the tracker does not sit in history and trap the back button.
  location.replace(destination);
})();
</script>
</body>
</html>
